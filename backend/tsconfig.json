{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "esnext",
      "dom"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": [
      "node"
    ],
    "paths": {
      "@backend": [
        "./src"
      ],
      "@backend/*": [
        "./src/*"
      ],
      "@platform": [
        "./src/platform"
      ],
      "@platform/*": [
        "./src/platform/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "*.mts",
    "*.mjs"
  ],
  "exclude": [
    "node_modules"
  ]
}
