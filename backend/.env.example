# Backend scripts (backend/scripts/*.mjs) read these from the environment. The npm helpers read the local values
# from `supabase status`, so for the local stack you do not need a file at all:
#   npm run db:seed                  seeds the fixtures and media
#   ADMIN_PASSWORD=... npm run db:bootstrap-admin -- you@example.com "Your Name" super_admin
# For a cloud project, export these first (service-role key = secret, never commit it) and run the scripts with node:
#   node scripts/seed-from-fixtures.mjs
#   ADMIN_PASSWORD=... node scripts/bootstrap-admin.mjs owner@example.com "Owner Name" super_admin
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The running app (Next.js) reads app/.env.local (local) or the Vercel environment (see app/.env.example).
