# Backend environment: every variable the backend reads (schema: backend/src/config/env.ts), with defaults and blanks.
# The Next.js app loads these from app/.env.local (local) or the Vercel project environment (staging, production);
# this file is the backend's own reference copy. Never put real values here: it is tracked by git.
#
# Backend scripts (backend/scripts/*.mjs) need only these two, which the npm helpers read from `supabase status`
# for the local stack; for a cloud project export them first and run the scripts with node:
#   SUPABASE_URL=            same value as NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY=   SECRET
#   node scripts/seed-from-fixtures.mjs
#   ADMIN_PASSWORD=... node scripts/bootstrap-admin.mjs owner@example.com "Owner Name" super_admin
# Details: docs/02-architecture/14-env-and-configuration.md and docs/07-planning/31-backend-deployment-runbook.md


# ---------------------------------------------------------------- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000     # production: https://your-domain
APP_ENV=local                                  # local | preview | production
DATA_SOURCE=supabase                           # supabase | mock (mock = fixtures, admin returns 404)
FEATURE_PUBLIC_CURTAIN=true
FEATURE_ROAMING_MASCOT=true

# ---------------------------------------------------------------- Privacy
CONSENT_TEXT_VERSION=v1                        # bump when the consent wording changes
PRIVACY_CONTACT_EMAIL=                         # shown for privacy requests

# ---------------------------------------------------------------- Supabase (dashboard > Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=                      # local: http://127.0.0.1:55321 (supabase status -o env)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                     # SECRET, server only: cron, webhooks, outbox worker, invitations

# ---------------------------------------------------------------- Internal endpoints and hashing
CRON_SECRET=                                   # 24+ characters; Vercel Cron sends it as a Bearer token. Required in production
IP_HASH_SALT=                                  # 16+ characters; salts hashed IPs and emails. Required in production
LOG_LEVEL=info                                 # debug | info | warn | error

# ---------------------------------------------------------------- Rate limiting (Upstash Redis > REST API)
RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_URL=                        # required in production while RATE_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Staff sign-in and sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MFA_REQUIRED_FOR_OPERATORS=false               # true = operators must set up an authenticator app
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=15
ADMIN_IP_ALLOWLIST=                            # optional comma-separated list

# ---------------------------------------------------------------- AI assistant (docs 26 to 30)
ASSISTANT_ENABLED=false                        # true shows the chat widget on public pages
ASSISTANT_MODE=mock                            # mock = scripted model, no network | live = NVIDIA hosted model (needs NVIDIA_API_KEY)
NVIDIA_API_KEY=                                # required when live: key from build.nvidia.com (server only, never commit)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b       # a tool-calling chat model that is still live: check GET /v1/models; retired models answer 410
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=60000                        # give up on the model after this long (some models take 30 s or more)
ASSISTANT_POLICY_MODE=fixed                    # fixed | shadow | canary | learned (needs a promoted artifact in policies/active.json)
ASSISTANT_LEARNING_MODE=false                  # true lets learned/canary modes explore (share below)
ASSISTANT_EXPLORATION_SHARE=0.1
ASSISTANT_CANARY_SHARE=0.1
ASSISTANT_VISITOR_DAILY_REQUESTS=40            # per visitor per day
ASSISTANT_GLOBAL_DAILY_REQUESTS=1000           # whole site per day; the free tier is rate limited

# ---------------------------------------------------------------- Email and notifications (Resend)
FEATURE_OUTBOX_ENABLED=true                    # false = global kill switch for automatic messages
FEATURE_STAFF_DIGEST=false                     # true = email and in-app daily digest to staff (needs EMAIL_PROVIDER=resend to leave the machine)
EMAIL_PROVIDER=log                             # log (nothing leaves the machine) | resend
RESEND_API_KEY=                                # required when EMAIL_PROVIDER=resend
EMAIL_FROM=                                    # required when EMAIL_PROVIDER=resend, e.g. TeddyPups <hello@your-domain>
WHATSAPP_PROVIDER=none                         # none = staff use wa.me links | cloud = WhatsApp Cloud API automation and webhooks
WHATSAPP_ACCESS_TOKEN=                         # required when cloud: permanent system-user token (server only)
WHATSAPP_PHONE_NUMBER_ID=                      # required when cloud: the sending number's id from Meta
WHATSAPP_APP_SECRET=                           # required when cloud: verifies the X-Hub-Signature-256 header on webhooks
WHATSAPP_VERIFY_TOKEN=                         # required when cloud: any long random string you also enter in Meta's webhook setup
WHATSAPP_API_VERSION=v21.0
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
QUIET_HOURS_TZ=Asia/Dubai
AUTOMATED_MSG_DAILY_CAP=5

# ---------------------------------------------------------------- Payments (Stripe)
PAYMENT_GATEWAYS=manual                        # manual | manual,stripe (manual is always available)
DEFAULT_CURRENCY=AED
STRIPE_SECRET_KEY=                             # sk_test_... first; required when PAYMENT_GATEWAYS includes stripe
STRIPE_WEBHOOK_SECRET=                         # whsec_... for the endpoint https://your-domain/api/webhooks/stripe

# ---------------------------------------------------------------- Tests only (never set in Vercel)
# E2E_ADMIN=1  E2E_BASE_URL=http://localhost:3103  SUPABASE_URL=  SUPABASE_ANON_KEY=  (see docs/07-planning/31)

# ---------------------------------------------------------------- Backend scripts only (not read by the app)
SUPABASE_URL=                                  # cloud: https://<ref>.supabase.co
ADMIN_PASSWORD=                                # first super admin password, 12+ characters, used once by bootstrap-admin
