# Names and safe defaults only. Copy to .env.local for local overrides. Never commit real secrets.
# The application reads the environment in one place only: src/shared/config/env.ts

# Public base URL (canonical links, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# local | preview | production
APP_ENV=local

# mock (frontend track). supabase is added in the backend track.
DATA_SOURCE=mock

# Feature flags
FEATURE_PUBLIC_CURTAIN=true
FEATURE_ROAMING_MASCOT=true

# Privacy (docs/03-security-privacy/06-security-architecture.md section 6)
CONSENT_TEXT_VERSION=v1
PRIVACY_CONTACT_EMAIL=

# --- Backend track (docs/02-architecture/14-env-and-configuration.md) ---
# Local Supabase (supabase start, ports 55320 to 55329). Get the keys with: supabase status -o env
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # server only: cron, webhooks, outbox worker, bootstrap script

# Rate limiting: Upstash in staging and production; in-memory fallback locally
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_ENABLED=true

# Internal endpoints and hashing (required in production)
# CRON_SECRET=                        # at least 24 characters
# IP_HASH_SALT=                       # at least 16 characters
LOG_LEVEL=info

# Authentication and session
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MFA_REQUIRED_FOR_OPERATORS=false
LOGIN_LOCK_THRESHOLD=10
LOGIN_LOCK_MINUTES=15
# ADMIN_IP_ALLOWLIST=                 # optional comma list

# Notifications (B8). EMAIL_PROVIDER=log keeps everything local; resend needs the next two.
FEATURE_OUTBOX_ENABLED=true
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM="TeddyPups <hello@your-domain>"
WHATSAPP_PROVIDER=none
QUIET_HOURS_START=21:00
QUIET_HOURS_END=08:00
QUIET_HOURS_TZ=Asia/Dubai
AUTOMATED_MSG_DAILY_CAP=5

# Payments (B9). `manual` is always available; add stripe only with both keys (test keys until the owner confirms live).
PAYMENT_GATEWAYS=manual
DEFAULT_CURRENCY=AED
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...     # from `stripe listen` locally or the dashboard endpoint /api/webhooks/stripe
